#pragma experiment("MODULE_TEMPLATING")
#pragma experiment("BRIDGE_CONNECT")

import ElectricPower
import ElectricLogic
import PoweredLED
import Diode
import PowerSwitchMOSFET

from "../components/FanConnector.py" import FanConnector

from "atopile/indicator-leds/indicator-leds.ato" import LEDIndicatorRed


module FanController:
    """
    Module containing the hardware needed to controll a fan
    - LED indicator
    - MOSFET power switch
    """

    # components
    fan_connector = new FanConnector
    led = new LEDIndicatorRed
    fan_power_switch = new PowerSwitchMOSFET<lowside=True, normally_closed=False>
    flyback_protection_diode = new Diode

    # external interfaces
    power_in = new ElectricPower
    control_input = new ElectricLogic
    fan_output = new ElectricPower

    # connections
    fan_power_switch.logic_in ~ control_input
    fan_connector.power ~> fan_power_switch ~> power_in

    fan_connector.power.lv ~> flyback_protection_diode ~> fan_connector.power.hv

    led.power ~> fan_power_switch ~> power_in

    # parametrization
    assert power_in.voltage is 5V +/- 5%
    assert flyback_protection_diode.forward_voltage <= 0.5V
    fan_power_switch.mosfet.lcsc_id = "C8545"
    fan_power_switch.pull_down_logic_in.package = "R0402"

