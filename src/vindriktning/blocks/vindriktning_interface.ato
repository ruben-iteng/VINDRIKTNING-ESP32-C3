import ElectricPower
import ElectricLogic
import UART_Base
import TXS0102DCUR_UART
from "../components/PM1006Connector.py" import PM1006Connector
from "fan_controller.ato" import FanController

module VindriktningInterface:
    """
    Module containing the hardware needed to connect to the fan and PM1006 particulate
    matter sensor (used in the IKEA VINDRIKTNING).
      - Controllable FAN
        - Fan LED indicator
      - Level shifted UART
    """

    # components
    fan_controller = new FanController
    pm_sensor_level_shifter = new TXS0102DCUR_UART
    pm_sensor_connector = new PM1006Connector

    # external interfaces
    power = new ElectricPower
    power_data = new ElectricPower
    fan_enable = new ElectricLogic
    uart = new UART_Base

    # connections
    fan_controller.control_input ~ fan_enable
    fan_controller.power_in ~ power

    # pm1006
    power ~ pm_sensor_level_shifter.voltage_b_power
    power ~ pm_sensor_connector.power
    power_data ~ pm_sensor_level_shifter.voltage_a_power

    uart ~ pm_sensor_level_shifter.voltage_a_bus
    pm_sensor_connector.data ~ pm_sensor_level_shifter.voltage_b_bus

    # parametrization
    assert power.voltage within 5V +/- 5%
    assert power_data.voltage within 3.3V +/- 5%
